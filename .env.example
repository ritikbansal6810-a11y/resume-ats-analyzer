# ════════════════════════════════════════════════════════════════════════════
# Resume ATS Analyzer — Environment Variables
# ════════════════════════════════════════════════════════════════════════════
#
# SETUP INSTRUCTIONS:
#   1. Copy this file:   copy .env.example .env   (Windows)
#                        cp .env.example .env      (Mac/Linux)
#   2. Open .env and replace the placeholder values with your real API keys.
#   3. Save the file.
#   4. Restart Streamlit:  streamlit run app.py
#
# SECURITY:
#   - NEVER commit .env to git.  (.gitignore already excludes it)
#   - NEVER share your API key.
#   - This .env.example file contains ONLY placeholders — safe to commit.
# ════════════════════════════════════════════════════════════════════════════

# ── Active Provider ────────────────────────────────────────────────────────
# Set to exactly one of:  openai | gemini | groq
LLM_PROVIDER=openai

# ── OpenAI (default) ───────────────────────────────────────────────────────
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ── Google Gemini (alternative) ────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── Groq (alternative — generous free tier) ────────────────────────────────
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ── Application Settings ───────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
